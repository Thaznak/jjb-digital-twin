{
  "name": "hellfest-twin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Digital twin mobile du Hellfest : carte isométrique, programme, plan de journée, équipe et météo. PWA hors ligne.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "npm run build && node scripts/inline-build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
