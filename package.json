{
  "name": "jjb-digital-twin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Digital twin d'un club de jiu-jitsu brésilien, sous forme de jeu de simulation isométrique.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "npm run build && node scripts/inline-build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
